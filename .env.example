# Ledger environment template. Copy to .env.local and fill in what you have.
# Nothing here is required to run the app: without any of these, Ledger starts in demo mode.
# Keys stay on the server; they are never sent to the browser.

# --- SEC EDGAR (free, no key) -------------------------------------------------
# Required by the SEC fair-access policy: identify your app and give a contact email.
# Used for XBRL company facts, filings and 8-K cadence based earnings estimates.
SEC_USER_AGENT="Ledger research app you@example.com"

# --- Market data (pick at least one for prices in connected mode) -------------
# Massive (formerly Polygon.io). Free "Basic" plan: 5 requests/minute, 2 years of
# end-of-day history, split-adjusted bars. https://massive.com/docs/rest/quickstart
MASSIVE_API_KEY=
# Override the API host if Massive publishes a new one (default https://api.massive.com).
# MASSIVE_BASE_URL=https://api.massive.com

# Alpha Vantage. Free tier: 25 requests/day; daily history limited to the latest
# 100 unadjusted sessions; quotes, company overview, earnings calendar and search.
# https://www.alphavantage.co/documentation/
ALPHAVANTAGE_API_KEY=
# Set to "true" only if your key is a premium key (unlocks adjusted full history).
# ALPHAVANTAGE_PREMIUM=false

# Which market-data provider to prefer when both keys are present: "massive" or "alphavantage".
# MARKET_DATA_PROVIDER=massive

# --- Storage ------------------------------------------------------------------
# SQLite file location (created on first run). Relative to the project root.
# LEDGER_DATABASE_PATH=./data/ledger.db

# --- Testing ------------------------------------------------------------------
# Optional: reuse an existing Chromium for Playwright instead of downloading one.
# PLAYWRIGHT_CHROMIUM_PATH=/usr/bin/chromium
